# Copy this file to .env and fill in your own values.
# Get a free RPC URL from https://infura.io or https://alchemy.com
# (free tier is plenty for testnet use).

SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
AMOY_RPC_URL=https://polygon-amoy.infura.io/v3/YOUR_PROJECT_ID

# Never put a private key with real funds in this file, or any .env file.
# This project only ever uses freshly-generated testnet keys.
